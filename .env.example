OPENUSD_QDRANT_URL=http://127.0.0.1:6333
OPENUSD_OLLAMA_URL=http://127.0.0.1:11434
OPENUSD_CHAT_MODEL=qwen3:4b
# Chosen on dev: qwen3:4b needs thinking on; qwen3.5:4b was best with it off.
OPENUSD_OLLAMA_REASONING=true
OPENUSD_EMBEDDING_MODEL=nomic-embed-text:v1.5
# Record the model digest here when publishing an evaluation.
# OPENUSD_EMBEDDING_REVISION=
# Retrieval: bm25, dense, hybrid or hybrid-rerank. Defaults are tuned on dev only
# (reports/retrieval_dev.md); re-tune after changing models or chunking.
OPENUSD_RETRIEVAL_MODE=hybrid-rerank
OPENUSD_RERANKER_MODEL=BAAI/bge-reranker-base
OPENUSD_TOP_K=8
# Refusal gates: cosine for dense/hybrid, cross-encoder score for hybrid-rerank.
OPENUSD_MIN_SCORE=0.6891
OPENUSD_RERANK_MIN_SCORE=-0.9831
# Answer generation: ollama (OPENUSD_CHAT_MODEL) or gemini. Embeddings always use Ollama.
OPENUSD_CHAT_PROVIDER=ollama
# Exact model ID from AI Studio, for example the Flash-Lite model under test.
OPENUSD_GEMINI_MODEL=
# Put the real key only in .env, which Git ignores. Never commit it.
OPENUSD_GEMINI_API_KEY=
# Optional: thinking budget (Gemini 2.5) or level (Gemini 3); blank keeps the model default.
OPENUSD_GEMINI_THINKING_BUDGET=
OPENUSD_GEMINI_THINKING_LEVEL=
# LLM judge for answer evaluation; must differ from the compared models.
OPENUSD_JUDGE_MODEL=gemini-3.8-flash
# Judge backend: gemini (uses OPENUSD_GEMINI_API_KEY) or openai-compatible, for any
# /chat/completions gateway. Put the gateway key only in .env.
OPENUSD_JUDGE_PROVIDER=gemini
OPENUSD_JUDGE_BASE_URL=
OPENUSD_JUDGE_API_KEY=
